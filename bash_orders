### SN38 DATAGEN — RunPod 32 vCPU / 128 GB + network volume (≥500GB–1TB)
# Wiki: Wikimedia enwiki pages-meta-history (NOT Ti-Ma)
# Per shard: download → extract → filter → DELETE archive+raw
# Save pre-mix corpus under snapshots/cutoff_2012/ for later 2011 re-filter
# Then: FineWeb-edu classifier → QA → mix → (later) train

# ========== 0) ON POD — once ==========
cd /workspace
git clone <YOUR_REPO_URL> sn38
cd sn38
bash scripts/runpod/setup.sh
# env.sh is written by setup.sh into the data volume (not the git repo).
# If missing, create it manually (see below) then:
source /workspace/sn38-data/env.sh
# Secrets go ONLY in /workspace/sn38-data/env.sh (on the volume, never in git):
#   export HF_TOKEN=hf_...              # peS2o / FineWeb / gated Usenet
#   export GUARDIAN_API_KEY=...         # 2012 news (free key: open-platform.theguardian.com/access/)
#   export USENET_DATASET=owner/name    # HF Usenet corpus (or use USENET_MBOX, see 1c)
# Manual env.sh if setup died before writing it:
# cat > /workspace/sn38-data/env.sh <<'EOF'
# export SN38_DATA_ROOT=/workspace/sn38-data
# export SN38_REPO=/workspace/sn38
# export HF_HOME=/workspace/sn38-data/hf_cache
# export WIKI_DUMP_ID=20261001
# export WIKI_DUMP_FORMAT=7z
# export PYTHONPATH=/workspace/sn38${PYTHONPATH:+:$PYTHONPATH}
# cd /workspace/sn38
# EOF
# source /workspace/sn38-data/env.sh
# export WIKI_DUMP_ID=20261001
# export WIKI_DUMP_FORMAT=7z
# bash scripts/runpod/run_datagen.sh wiki-list

# ========== 1) START SOURCES (128GB: FineWeb WITHOUT wiki) ==========
bash scripts/runpod/run_full_scale.sh start
# jobs: sn38-full-pes2o | sn38-full-fineweb | sn38-full-books | sn38-full-news
# news = Wikinews (no key, <1h) + Guardian (only if GUARDIAN_API_KEY set; daily call cap → ~2–3 days)
# wiki is NOT started here — parallel wiki+fineweb OOMs on 128GB

# ========== 1b) AFTER fineweb DONE — resume wiki alone ==========
# (also use this after OOM / false [DONE] wiki)
# Parallel shards on 128GB: start with 2 (3 max). Completed shards are skipped.
export WIKI_WORKERS=2
bash scripts/runpod/run_full_scale.sh restart-wiki
# resumes from state (~skip completed shards); log: logs/full_wiki.log
# status must show wiki state completed_shards≈980 before mix

# ========== 1c) OPTIONAL — Usenet (HF ≈ half a day; archive.org mbox = days) ==========
# HF backend (needs USENET_DATASET in env.sh):
# bash scripts/runpod/run_full_scale.sh start-usenet
# mbox backend (downloaded archive.org files):
# USENET_MBOX=/workspace/usenet_raw bash scripts/runpod/run_full_scale.sh start-usenet
# if news hit the Guardian cap / failed:  bash scripts/runpod/run_full_scale.sh restart-news

# ========== 2) MONITOR until ALL DONE ==========
bash scripts/runpod/run_full_scale.sh status
tail -f /workspace/sn38-data/logs/full_*.log
# Do NOT continue until wiki (real 980 shards) + pes2o + fineweb + books + news show DONE
# (usenet too, if you started it)
# ls -lh $SN38_DATA_ROOT/filtered/

# ========== 3) SNAPSHOT date-filtered 2012 (BEFORE edu/mix) — keep for 2011 ==========
bash scripts/runpod/run_full_scale.sh snapshot-filtered
# → $SN38_DATA_ROOT/snapshots/cutoff_2012/filtered/*.jsonl

# ========== 3b) TOKENIZER — train once on the filtered corpus, then CHECK ==========
# Prefer 5M docs + wiki/news-weighted sample for near-zero lone-space rate (~30–90 min CPU).
export SN38_DATA_ROOT=/workspace/sn38-data
python -m train.train_tokenizer --out $SN38_DATA_ROOT/tokenizer --max-docs 5000000 --check \
  --in \
    $SN38_DATA_ROOT/filtered/wikipedia_2012.jsonl \
    $SN38_DATA_ROOT/filtered/news_2012.jsonl \
    $SN38_DATA_ROOT/filtered/pes2o.jsonl \
    $SN38_DATA_ROOT/filtered/books.jsonl \
    $SN38_DATA_ROOT/filtered/fineweb_edu.jsonl
# must print "ok": true (exit 0). Perfect = lone_space 0 + mismatch <1%.
# Keep this SAME tokenizer for later vintages (2011, ...) too.
# cp -a $SN38_DATA_ROOT/tokenizer $SN38_DATA_ROOT/snapshots/cutoff_2011/tokenizer

# ========== 4) EDU CLASSIFIER + QA + MIX ==========
# Prefer GPU for edu pass (CPU works, very slow)
bash scripts/runpod/run_full_scale.sh mix
# Mix = streaming weighted interleave: shares/epochs in train/config.py (MIX_SHARES, MIX_MAX_EPOCHS),
# output size MIX_TOTAL_TOKENS=35B — must match train_clm --total-tokens.
# Check the plan BEFORE training (also written to mix/train_mix_plan.json):
#   python -m train.data.build_mix_all --skip-edu --dry-run
#   look for CAPPED / "got X% vs target" warnings; tune with --share name=x / --max-epochs name=n
# also snapshots filtered_edu at end:
# → $SN38_DATA_ROOT/filtered_edu/
# → $SN38_DATA_ROOT/mix/train_mix.jsonl
# → $SN38_DATA_ROOT/snapshots/cutoff_2012/filtered_edu/*.jsonl

# Manual split (optional):
#   bash scripts/runpod/run_full_scale.sh edu
#   bash scripts/runpod/run_full_scale.sh snapshot-edu
#   python -m train.data.build_mix_all --skip-edu

# ========== 5) FREEZE MIX ==========
cp -a $SN38_DATA_ROOT/mix/train_mix.jsonl $SN38_DATA_ROOT/mix/train_mix_2012_v1.jsonl
cp -a $SN38_DATA_ROOT/mix/train_mix_plan.json $SN38_DATA_ROOT/mix/train_mix_2012_v1_plan.json
ls -lh $SN38_DATA_ROOT/snapshots/cutoff_2012/
ls -lh $SN38_DATA_ROOT/mix/train_mix_2012_v1.jsonl

