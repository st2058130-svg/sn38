# Copy to /workspace/sn38-data/.env or export before running
#   set -a; source scripts/runpod/env.example; set +a

# Persist all JSONL / state on a network volume (NOT tiny container disk)
export SN38_DATA_ROOT=/workspace/sn38-data

# Optional overrides
export SN38_CHECKPOINT_DIR=/workspace/sn38-data/checkpoints
export SN38_EXPORT_DIR=/workspace/sn38-data/export

# Wikimedia enwiki pages-meta-history (NOT Ti-Ma).
# 7z ≈ 241GB remote total; pipeline keeps only ONE shard on disk at a time.
export WIKI_DUMP_ID=20261001
export WIKI_DUMP_FORMAT=7z

# HuggingFace (peS2o / FineWeb)
# export HF_TOKEN=hf_xxx
export HF_HOME=/workspace/sn38-data/hf_cache

# Repo root on the pod (setup.sh sets this)
# export SN38_REPO=/workspace/sn38
